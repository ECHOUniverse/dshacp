{
  "name": "@hanxu131/dshacp",
  "description": "Zed-first ACP v1 server driving DeepSeek Harness (DSH): standalone stdio bridge with token streaming, tool calls, approval, plan, and session management",
  "version": "0.2.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dshacp": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./bin": {
      "types": "./lib/types/bin.d.ts",
      "default": "./lib/bin.js"
    },
    "./codec": {
      "types": "./lib/types/codec.d.ts",
      "default": "./lib/codec.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.yml",
    "cordis.patch.yml",
    "dshacp.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ECHOUniverse/dshacp.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-base": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-cmdline": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-cordis-host-runner": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-persona": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-ask-user": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-cordis": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-terminal": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-terminal-bash": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-bash-persistent": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@linxin666/dsh-ssh": "^0.3.14",
    "@types/node": "^24.0.0",
    "commander": "^13.1.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'tests/*.test.mjs'",
    "test:unit": "node --test 'tests/codec*.test.mjs' 'tests/settle-config.test.mjs' 'tests/bridge.usage.test.mjs' 'tests/elicitation-map.test.mjs' 'tests/preset.test.mjs'",
    "test:e2e": "node --test 'tests/*.e2e.test.mjs'",
    "prepublishOnly": "npm run build && npm run test:unit",
    "release": "bash scripts/release.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-base": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-cmdline": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-cordis-host-runner": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-permission-presets": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-title": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subagent": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-user-questions": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@linxin666/dsh-ssh": "^0.3.14"
  },
  "peerDependenciesMeta": {
    "@linxin666/dsh-ssh": {
      "optional": true
    }
  }
}
